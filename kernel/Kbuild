# 6.18 exports the external module source as srcroot when M/MO are used.
ifneq ($(srcroot),)
KSU_KERNEL_DIR := $(srcroot)
endif
endif
ifndef KSU_KERNEL_DIR
ifeq ($(filter /%,$(src)),)
KSU_KERNEL_DIR := $(srctree)/$(src)
else
KSU_KERNEL_DIR := $(src)
endif
endif

ccflags-y += -I$(KSU_KERNEL_DIR) -I$(KSU_KERNEL_DIR)/include

obj-$(CONFIG_KSU) += kernelsu.o

MDIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))

# Workaround bazel
# https://github.com/tiann/KernelSU/pull/316#issuecomment-1479043219
GIT := $(shell PATH="$$PATH":/usr/bin:/usr/local/bin which git)
ifneq ($(GIT),)
# Check if this is a git repository
# Try to detect Git repo intelligently
GIT_ROOT := $(shell cd $(MDIR) && $(GIT) rev-parse --show-toplevel 2>/dev/null)
ifneq ($(GIT_ROOT),)
KERNEL_GIT_ROOT := $(shell cd $(srctree) && $(GIT) rev-parse --show-toplevel 2>/dev/null)
ifneq ($(GIT_ROOT),$(KERNEL_GIT_ROOT))
# Only set version if it's a different repo from kernel
$(shell cd $(GIT_ROOT) && [ -f .git/shallow ] && $(GIT) fetch --unshallow 2>/dev/null || true)
KSU_GIT_VERSION := $(shell cd $(GIT_ROOT) && $(GIT) rev-list --count HEAD 2>/dev/null)
KSU_GIT_VERSION_VALID := 1
$(info -- KernelSU: Git repo detected at $(GIT_ROOT))
endif
endif
else
$(warning -- KernelSU: Git not detected, make sure git is installed in your PATH!)
endif


# ------------------------------------------------------------------------------------------------
# Fork version identity. This tree is an upstream source SNAPSHOT: its local git history is 23
# commits, so the git-derived scheme below can only produce 30000 + 23 = 30023, far under the
# manager's hard gate (manager Natives.MINIMAL_SUPPORTED_KERNEL = 32513). The manager pins its own
# identity in manager/gradle.properties (KSU_VERSION_CODE=32601) for exactly that reason, so the
# LKM reads the SAME value here: kernel/driver and manager agree by construction.
#
# This is not theoretical. The CI LKM matrix (.github/workflows/build-lkm-fork.yml -> upstream
# ddk-lkm.yml) checked this repo out at /__w/KernelSU-AI/KernelSU-AI while the workflow's
# `git config --global --add safe.directory` names upstream's /__w/KernelSU/KernelSU, so git
# detection inside the DDK container failed silently and all 16 published modules were built with
# the hardcoded fallback -DKSU_VERSION=16 (measured by disassembling
# userspace/ksud/bin/aarch64/android15-6.6_kernelsu.ko: do_get_info stores version 16, flags 1).
#
# Precedence: explicit KSU_VERSION_CODE (make or env) > manager/gradle.properties > git > 16.
# ------------------------------------------------------------------------------------------------
ifndef KSU_VERSION_CODE
# Two readers, because the build environment varies: sed when a POSIX shell is available (the CI
# DDK containers), make's own $(file <) otherwise (no shell needed at all). $(wildcard) guards
# both, so a missing file falls through to the git/16 path instead of breaking the build.
KSU_VERSION_PROPS := $(wildcard $(MDIR)../manager/gradle.properties)
ifneq ($(KSU_VERSION_PROPS),)
KSU_VERSION_CODE := $(shell sed -n 's/^KSU_VERSION_CODE=\([0-9][0-9]*\).*/\1/p' "$(KSU_VERSION_PROPS)" 2>/dev/null)
ifeq ($(KSU_VERSION_CODE),)
KSU_VERSION_CODE := $(patsubst KSU_VERSION_CODE=%,%,$(filter KSU_VERSION_CODE=%,$(file <$(KSU_VERSION_PROPS))))
endif
endif
endif

ifneq ($(KSU_VERSION_CODE),)
$(eval KSU_VERSION=$(KSU_VERSION_CODE))
$(info -- KernelSU version: $(KSU_VERSION) (pinned: manager/gradle.properties))
else
ifdef KSU_GIT_VERSION_VALID
# ksu_version: major * 10000 + git version + 200 for historical reasons
$(eval KSU_VERSION=$(shell expr 30000 + $(KSU_GIT_VERSION)))
$(info -- KernelSU version: $(KSU_VERSION))
else
# If there is no .git directory and no pinned version, use the upstream default
$(warning "KSU_GIT_VERSION not defined! It is better to make KernelSU a git repository!")
$(warning "and no pinned KSU_VERSION_CODE was found in manager/gradle.properties")
$(eval KSU_VERSION=16)
endif
endif

ccflags-y += -DKSU_VERSION=$(KSU_VERSION)

KSU_NEW_DCACHE_FLUSH := $(shell grep -q __flush_dcache_area $(srctree)/arch/arm64/include/asm/cacheflush.h ; echo $$?)
$(info -- KSU_NEW_DCACHE_FLUSH: $(KSU_NEW_DCACHE_FLUSH))


# ------------------------------------------------------------------------------------------------
# Fork identity. Upstream hardcodes ITS OWN manager identity here (the official v2 signer: DER
# length 0x033b, cert sha256 c371061b...); this fork does the same with its own: the project
# release key (_artifacts/builder/keystore/kernelsu-ai-release.jks, public facts in
# _tools/project-signer.json) and the fork applicationId. These are defaults, not hard overrides,
# so a caller can still build another identity with
#   make KSU_EXPECTED_SIZE=... KSU_EXPECTED_HASH=... KSU_MANAGER_PACKAGE=...
# KSU_MANAGER_PACKAGE is defined by default because the signer alone is not proof of identity: any
# app signed with the same key would otherwise be crowned (measured on device 67a86199, where
# moe.nb4a.debug stole the crown). See docs/root-crown-appid-fix.md and docs/upstream-alignment.md.
# ------------------------------------------------------------------------------------------------
ifndef KSU_EXPECTED_SIZE
KSU_EXPECTED_SIZE := 0x342
endif

ifndef KSU_EXPECTED_HASH
KSU_EXPECTED_HASH := ca40afa835e460be5dcfd0743296d95c3275b9e51673de8b6fd0a64665a83eec
endif

ifndef KSU_MANAGER_PACKAGE
KSU_MANAGER_PACKAGE := me.weishu.kernelsu.hide
endif

ifdef KSU_MANAGER_PACKAGE
ccflags-y += -DKSU_MANAGER_PACKAGE=\"$(KSU_MANAGER_PACKAGE)\"
$(info -- KernelSU Manager package name: $(KSU_MANAGER_PACKAGE))
endif

$(info -- KernelSU Manager signature size: $(KSU_EXPECTED_SIZE))
$(info -- KernelSU Manager signature hash: $(KSU_EXPECTED_HASH))

ccflags-y += -DEXPECTED_SIZE=$(KSU_EXPECTED_SIZE)
ccflags-y += -DEXPECTED_HASH=\"$(KSU_EXPECTED_HASH)\"

ifdef KSU_EXPECTED_SIZE2
ifndef KSU_EXPECTED_HASH2
$(error KSU_EXPECTED_HASH2 must be set when KSU_EXPECTED_SIZE2 is set)
endif
ccflags-y += -DEXPECTED_SIZE2=$(KSU_EXPECTED_SIZE2)
ccflags-y += -DEXPECTED_HASH2=\"$(KSU_EXPECTED_HASH2)\"
$(info -- KernelSU Manager signature size2: $(KSU_EXPECTED_SIZE2))
$(info -- KernelSU Manager signature hash2: $(KSU_EXPECTED_HASH2))
endif

ccflags-y += -DKSU_NEW_DCACHE_FLUSH=$(KSU_NEW_DCACHE_FLUSH)

ccflags-y += -Wno-strict-prototypes -Wno-int-conversion -Wno-gcc-compat -Wno-missing-prototypes
ccflags-y += -Wno-declaration-after-statement -Wno-unused-function

