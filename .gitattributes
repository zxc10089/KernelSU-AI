*.bat eol=crlf

# Shell scripts must stay LF. core.autocrlf=true would otherwise rewrite them to CRLF
# on checkout, and a CR before every newline breaks them on Android:
#   * userspace/ksud/src/installer.sh is include_str!-embedded into ksud, so CRLF there
#     ships a broken installer inside the APK;
#   * _tools/hiding-props-module/*.sh are zipped verbatim into a KernelSU module, where
#     the CR lands inside the shebang and every command line.
*.sh text eol=lf

# The props module's data files are also consumed verbatim on the device (not on
# Windows): ksud parses module.prop, and resetprop parses props.txt as NAME=VALUE.
# With core.autocrlf=true a fresh checkout would hand them CRLF, and the CR lands
# *inside the value* rather than acting as a line ending -- version becomes
# "v1.0.4\r" and the last property's value gains a stray CR.
_tools/hiding-props-module/* text eol=lf
